<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One light theme only: no values-night, and the phone's dark mode is ignored. -->
    <style name="Theme.MyMusicApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
